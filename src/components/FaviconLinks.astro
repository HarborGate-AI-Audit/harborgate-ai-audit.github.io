---
/**
 * FaviconLinks.astro
 *
 * Uses BASE_URL so the links work both at the domain root and under a
 * GitHub Pages project subpath configured with Astro's `base` option.
 */
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const asset = (filename: string) => `${base}${filename}`;
---

<link rel="icon" href={asset('favicon.ico')} />
<link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" sizes="any" />
<link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} sizes="180x180" />
<link rel="manifest" href={asset('site.webmanifest')} />
<meta name="theme-color" content="#ffffff" />
