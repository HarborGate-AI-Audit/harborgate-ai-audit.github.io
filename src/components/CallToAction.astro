---
interface Props {
  title: string;
  body: string;
  href: string;
  label: string;
}

const { title, body, href, label } = Astro.props;
---

<section class="call-to-action">
  <div class="call-to-action__content flow">
    <h2>{title}</h2>
    <p>{body}</p>
    <p><a class="call-to-action__link" href={href}>{label}</a></p>
  </div>
</section>

<style>
  .call-to-action {
    min-width: 0;
    padding: clamp(var(--space-5), 5vw, var(--space-7));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
  }

  .call-to-action__content {
    max-width: var(--width-reading);
  }

  .call-to-action__content p {
    color: var(--color-text-muted);
  }

  .call-to-action__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-small);
    color: var(--color-surface);
    background: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .call-to-action__link:hover {
    color: var(--color-surface);
    background: var(--color-accent-strong);
  }
</style>
