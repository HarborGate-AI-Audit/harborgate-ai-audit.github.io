---
import type { ServiceDefinition } from '../data/services';

interface Props {
  service: ServiceDefinition;
  showDetailLink?: boolean;
}

const { service, showDetailLink = false } = Astro.props;
const titleId = 'service-card-' + service.id + '-title';
const detailHref = '/services/#service-' + service.id;
---

<article class="service-card" aria-labelledby={titleId}>
  <h3 class="service-card__title" id={titleId}>{service.name}</h3>
  <p class="service-card__summary">{service.introduction[0]}</p>
  {
    showDetailLink && (
      <p class="service-card__action">
        <a href={detailHref}>詳細を見る</a>
      </p>
    )
  }
</article>

<style>
  .service-card {
    display: grid;
    min-width: 0;
    gap: var(--space-3);
    padding: clamp(var(--space-5), 4vw, var(--space-6));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
  }

  .service-card__title {
    font-size: clamp(1.35rem, 1.2rem + 0.75vw, 1.75rem);
  }

  .service-card__summary {
    color: var(--color-text-muted);
  }

  .service-card__action {
    align-self: end;
    padding-block-start: var(--space-2);
  }
</style>
