---
import type { ServiceDefinition } from '../data/services';

interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;
const titleId = 'service-' + service.id + '-title';
---

<article class="service-card" id={'service-' + service.id} aria-labelledby={titleId}>
  <header class="service-card__header">
    <p class="service-card__category">{service.category}</p>
    <h3 class="service-card__title" id={titleId}>{service.name}</h3>
    <p class="service-card__summary">{service.summary}</p>
  </header>

  <div class="service-card__section">
    <h4>主な対象</h4>
    <ul>
      {service.targets.map((target) => <li>{target}</li>)}
    </ul>
  </div>

  <div class="service-card__section">
    <h4>主なアウトプット</h4>
    <ul>
      {service.typicalOutputs.map((output) => <li>{output}</li>)}
    </ul>
  </div>

  <div class="service-card__section">
    <h4>支援の進め方</h4>
    <p>{service.supportApproach}</p>
  </div>
</article>

<style>
  .service-card {
    display: grid;
    min-width: 0;
    gap: var(--space-5);
    padding: clamp(var(--space-5), 4vw, var(--space-6));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
  }

  .service-card__header {
    display: grid;
    gap: var(--space-3);
  }

  .service-card__category {
    color: var(--color-accent-strong);
    font-size: var(--font-size-small);
    font-weight: 700;
  }

  .service-card__title {
    font-size: clamp(1.35rem, 1.2rem + 0.75vw, 1.75rem);
  }

  .service-card__summary,
  .service-card__section p {
    color: var(--color-text-muted);
  }

  .service-card__section {
    display: grid;
    gap: var(--space-2);
  }

  .service-card__section h4 {
    font-size: var(--font-size-body);
  }

  .service-card ul {
    display: grid;
    gap: var(--space-1);
    padding-inline-start: var(--space-5);
    margin-block: 0;
  }
</style>
