---
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import { siteConfig } from '../../config/site';
import { individualDesignPrinciple, services } from '../../data/services';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = siteConfig.navigation.find((item) => item.href === '/services/')!.label;
const pageDescription = `${pageTitle}：${siteConfig.brand.defaultDescription}`;
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/services/">
  <PageHero title={pageTitle} eyebrow={siteConfig.brand.name} />

  <section class="page-section container flow" aria-labelledby="service-position-title">
    <h2 id="service-position-title">課題に合わせた支援</h2>
    <p class="section-lead">{individualDesignPrinciple}</p>
  </section>

  <section class="page-section container flow" aria-labelledby="service-list-title">
    <h2 id="service-list-title">サービス一覧</h2>
    <nav aria-label="サービス詳細">
      <div class="service-grid">
        {services.map((service) => <ServiceCard service={service} showDetailLink />)}
      </div>
    </nav>
  </section>

  <div class="service-details container">
    {services.map((service) => <ServiceDetail service={service} />)}
  </div>

</BaseLayout>

<style>
  .page-section {
    padding-block: var(--space-7);
  }

  .section-lead {
    max-width: var(--width-reading);
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-5);
  }

  .service-details {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-5) var(--space-7);
  }
</style>
